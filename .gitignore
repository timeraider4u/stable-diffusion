# Stable-Diffusion models (SafeTensor files) can be huge (multiple GiB) and should not be committed
*.safetensors

# Ignore any local caches used by StableDiffusion
.cache

# Ignore any local configurations
/data/config

# Ignore backup files
*~
*.bak

# Ignore input file
/input

# Ignore output files
/output
!/output/.keep

